{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/account-deletion",
      "schedule": "0 3 * * *"
    }
  ],
  "installCommand": "git config --global url.\"https://${SMARANA_GIT_TOKEN}@github.com/\".insteadOf \"ssh://git@github.com/\" && npm install",
  "git": {
    "deploymentEnabled": {
      "fix/akasha-model-selection-20261110": false,
      "audit/akasha-composition-20261111-f47c": false,
      "audit/akasha-prime-j1-20261111-2e4cf86": false
    }
  }
}
